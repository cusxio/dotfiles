{
  "lastChangelogVersion": "0.84.3",
  "theme": "Kanagawa Wave",
  "treeFilterMode": "no-tools",
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:@ff-labs/pi-fff",
    "npm:@ogulcancelik/pi-minimal-footer",
    "npm:@ogulcancelik/pi-codex-compaction",
    "npm:pi-subagents",
    "npm:pi-web-access"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "npmCommand": [
    "mise",
    "exec",
    "pnpm@latest",
    "--",
    "pnpm"
  ],
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-terra",
    "defaultThinking": "medium",
    "defaultExtensions": [],
    "agentOverrides": {
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "librarian": {
        "model": "openai-codex/gpt-5.6-sol"
      },
      "worker": {
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "researcher": {
        "extensions": [
          "npm:pi-web-access"
        ]
      }
    }
  },
  "tuiMode": "fullscreen"
}