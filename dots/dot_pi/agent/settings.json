{
  "lastChangelogVersion": "0.84.2",
  "theme": "Kanagawa Wave",
  "treeFilterMode": "no-tools",
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:@ff-labs/pi-fff",
    "npm:@ogulcancelik/pi-minimal-footer",
    "npm:@ogulcancelik/pi-codex-compaction",
    "npm:pi-subagents",
    "npm:pi-web-access"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "npmCommand": [
    "mise",
    "exec",
    "pnpm@latest",
    "--",
    "pnpm"
  ],
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-terra",
    "defaultThinking": "medium",
    "defaultExtensions": [],
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "defaultContext": "fresh"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "defaultContext": "fresh"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash"
        ],
        "defaultContext": "fresh",
        "acceptanceRole": "read-only"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "advisor": {
        "disabled": true
      },
      "researcher": {
        "disabled": false,
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "tools": [
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "source_check",
          "intercom"
        ],
        "extensions": [
          "npm:pi-web-access"
        ],
        "defaultContext": "fresh"
      },
      "context-builder": {
        "disabled": true
      }
    }
  },
  "tuiMode": "fullscreen"
}