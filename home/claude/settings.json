{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/mise/installs/github-dicklesworthstone-destructive-command-guard/latest/dcg\""
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
